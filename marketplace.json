{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "oh-my-bb",
  "displayName": "oh-my-bb",
  "description": "Independent BB plugins maintained by Hemanth Soni.",
  "plugins": [
    {
      "id": "dispatch",
      "displayName": "Dispatch",
      "description": "Drive BB by voice. Talk to a named agent in the app or over a phone call, and it reads, starts, and steers your threads.",
      "icon": { "url": "plugins/dispatch/icons/dispatch.svg" },
      "tags": [
        "agents",
        "openai",
        "phone",
        "sip",
        "threads",
        "twilio",
        "voice"
      ],
      "author": {
        "name": "Hemanth Soni",
        "github": "hemaaanth",
        "url": "https://github.com/hemaaanth"
      },
      "source": {
        "git": {
          "url": "https://github.com/hemaaanth/oh-my-bb.git",
          "subdir": "plugins/dispatch",
          "range": "^0.3.1",
          "tagPrefix": "dispatch/"
        }
      }
    },
    {
      "id": "model-gateway",
      "displayName": "Model Gateway",
      "description": "Keep coding when a Claude or ChatGPT account reaches its limit.",
      "icon": "Route",
      "tags": [
        "accounts",
        "agents",
        "claude-code",
        "codex",
        "failover",
        "models",
        "providers",
        "routing"
      ],
      "author": {
        "name": "Hemanth Soni",
        "github": "hemaaanth",
        "url": "https://github.com/hemaaanth"
      },
      "source": {
        "git": {
          "url": "https://github.com/hemaaanth/oh-my-bb.git",
          "subdir": "plugins/model-gateway",
          "range": "^0.3.0",
          "tagPrefix": "model-gateway/"
        }
      }
    },
    {
      "id": "pages",
      "displayName": "Pages",
      "description": "Publish and share pages, with the same live UI in chat and on pages.",
      "icon": "FileText",
      "tags": [
        "artifacts",
        "charts",
        "html",
        "markdown",
        "reports",
        "sharing"
      ],
      "author": {
        "name": "Hemanth Soni",
        "github": "hemaaanth",
        "url": "https://github.com/hemaaanth"
      },
      "source": {
        "git": {
          "url": "https://github.com/hemaaanth/oh-my-bb.git",
          "subdir": "plugins/pages",
          "range": "^0.6.0",
          "tagPrefix": "pages/"
        }
      }
    },
    {
      "id": "webhooks",
      "displayName": "Webhooks",
      "description": "Receive webhooks from PostHog, Slack, and other services, and turn them into thread messages, new threads, automation runs, or plugin calls.",
      "icon": { "url": "plugins/webhooks/icons/webhook.svg" },
      "tags": [
        "automations",
        "events",
        "ingress",
        "posthog",
        "slack",
        "standard-webhooks",
        "threads",
        "webhooks"
      ],
      "author": {
        "name": "Hemanth Soni",
        "github": "hemaaanth",
        "url": "https://github.com/hemaaanth"
      },
      "source": {
        "git": {
          "url": "https://github.com/hemaaanth/oh-my-bb.git",
          "subdir": "plugins/webhooks",
          "range": "^0.1.0",
          "tagPrefix": "webhooks/"
        }
      }
    }
  ]
}
