{
  "name": "bb-plugin-agent-profiles",
  "version": "0.3.0",
  "description": "Portable, versioned agent profiles for BB threads and plugins.",
  "license": "MIT",
  "keywords": [
    "bb",
    "plugin",
    "agents",
    "profiles"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "Agents",
    "description": "Save versioned agent personas and start BB threads with family-aware model levels.",
    "branding": {
      "icon": "./assets/robot.svg",
      "experimental_icons": {
        "agent-emoji-1f91d": "./assets/emoji/1f91d.svg",
        "agent-emoji-1f4ca": "./assets/emoji/1f4ca.svg",
        "agent-emoji-1f916": "./assets/emoji/1f916.svg",
        "agent-emoji-1fa84": "./assets/emoji/1fa84.svg",
        "agent-emoji-1f3a8": "./assets/emoji/1f3a8.svg",
        "agent-emoji-1f3ac": "./assets/emoji/1f3ac.svg",
        "agent-emoji-1f4dd": "./assets/emoji/1f4dd.svg",
        "agent-emoji-1f58a": "./assets/emoji/1f58a.svg",
        "agent-emoji-1f913": "./assets/emoji/1f913.svg",
        "agent-emoji-1f919": "./assets/emoji/1f919.svg",
        "agent-emoji-1f310": "./assets/emoji/1f310.svg",
        "agent-emoji-1f4e3": "./assets/emoji/1f4e3.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./provider/host.ts",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "LICENSE",
    "THIRD_PARTY.md",
    "THIRD_PARTY_LICENSES.txt",
    "README.md",
    "SETUP.md",
    "PRIVACY.md",
    "PLUGIN_OVERVIEW.md",
    "RUNTIME_CONTRACT.md",
    "ASSIGNMENT_HANDOFF.md",
    "CHANGELOG.md",
    "provider/LICENSE",
    "provider/NOTICE",
    "provider/vendor/hempi/LICENSE",
    "provider/vendor/hempi/REVISION",
    "provider/vendor/hempi/NOTICE.md",
    "provider/vendor/hempi/LOCAL_PATCH.md",
    "provider/vendor/hempi/OMP-LICENSE",
    "provider/vendor/hempi/OPTCHAT-LICENSE"
  ],
  "scripts": {
    "build": "node scripts/refresh-hempi.mjs --check && node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "emoji-picker-react": "4.22.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^30.1.2",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
