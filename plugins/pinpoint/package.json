{
  "name": "bb-plugin-pinpoint",
  "version": "0.2.1",
  "description": "Point at a live page and send reviewable visual feedback to BB agents.",
  "license": "MIT",
  "author": "Hemanth Soni",
  "homepage": "https://github.com/hemaaanth/oh-my-bb/tree/main/plugins/pinpoint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemaaanth/oh-my-bb.git",
    "directory": "plugins/pinpoint"
  },
  "bugs": {
    "url": "https://github.com/hemaaanth/oh-my-bb/issues"
  },
  "files": [
    "dist",
    "docs",
    "icons",
    "skills",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY.md"
  ],
  "keywords": [
    "bb",
    "bb-plugin",
    "visual-feedback",
    "browser",
    "ai-agents"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.46.1",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Pinpoint",
    "description": "Point at a live page and send reviewable visual feedback to BB agents.",
    "branding": {
      "icon": "./icons/pinpoint.svg",
      "experimental_icons": {
        "target": "./icons/pinpoint.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "npm run generate:public && bb plugin build && node scripts/sanitize-build.mjs",
    "generate:public": "node scripts/build-public-client.mjs",
    "typecheck": "npm run generate:public && tsc --noEmit",
    "test": "npm run generate:public && vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@zumer/snapdom": "^2.24.3",
    "es-module-lexer": "^1.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "esbuild": "^0.28.2",
    "hono": "^4.11.9",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
