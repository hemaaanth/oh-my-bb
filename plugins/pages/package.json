{
  "name": "bb-plugin-pages",
  "version": "0.1.1",
  "description": "Publish versioned HTML and Markdown pages in project folders, browse them in BB, and share them securely.",
  "license": "MIT",
  "author": "Hemanth Soni",
  "homepage": "https://github.com/hemaaanth/oh-my-bb/tree/main/plugins/pages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemaaanth/oh-my-bb.git",
    "directory": "plugins/pages"
  },
  "bugs": {
    "url": "https://github.com/hemaaanth/oh-my-bb/issues"
  },
  "keywords": [
    "bb",
    "artifacts",
    "charts",
    "html",
    "markdown",
    "reports"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.84"
  },
  "bb": {
    "name": "Pages",
    "description": "Publish versioned pages in project folders, browse them in BB, and share them securely.",
    "branding": {
      "icon": "FileText"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build:charts": "node render/charts-runtime/build.mjs",
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "highcharts": "13.0.0",
    "markdown-it": "^14.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.44.0",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "esbuild": "0.28.2",
    "hono": "^4.11.9",
    "jsdom": "26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
