{
  "name": "bb-plugin-pages",
  "version": "0.6.0",
  "description": "Publish and share pages, with the same live UI in chat and on pages.",
  "license": "MIT",
  "author": "Hemanth Soni",
  "homepage": "https://github.com/hemaaanth/oh-my-bb/tree/main/plugins/pages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemaaanth/oh-my-bb.git",
    "directory": "plugins/pages"
  },
  "bugs": {
    "url": "https://github.com/hemaaanth/oh-my-bb/issues"
  },
  "keywords": [
    "bb",
    "artifacts",
    "charts",
    "html",
    "markdown",
    "reports"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.46.1",
    "bbPluginSdk": ">=0.6.54"
  },
  "bb": {
    "name": "Pages",
    "description": "Publish and share pages, with the same live UI in chat and on pages.",
    "branding": {
      "icon": "FileText"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build:charts": "node render/charts-runtime/build.mjs",
    "build:spec": "node render/spec-runtime/build.mjs",
    "build": "bb plugin build && node render/spec-runtime/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:icons": "node render/icons/build.mjs"
  },
  "dependencies": {
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "highcharts": "13.0.0",
    "markdown-it": "^14.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.54",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bb-app": "0.46.1",
    "better-sqlite3": "12.11.1",
    "cron-parser": "^5.5.0",
    "esbuild": "0.28.2",
    "hono": "^4.11.9",
    "jsdom": "26.1.0",
    "mingcute_icon": "2.9.72",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
