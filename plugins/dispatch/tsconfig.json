{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "shared/**/*.ts",
    "server/**/*.ts",
    "voice/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "scripts/**/*.ts"
  ]
}
