{
  "name": "bb-plugin-catalog",
  "version": "0.3.1",
  "description": "Executor v2 connections, approvals, and app skills for BB agents.",
  "license": "MIT",
  "files": [
    "dist",
    "icons",
    "skills",
    "LICENSE",
    "THIRD_PARTY.md",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Executor",
    "description": "Sign in to Executor connections, choose which connection each project or agent uses, and project the skills Executor apps ship.",
    "branding": {
      "icon": "./icons/catalog.svg",
      "experimental_icons": {
        "audio-lines": "./assets/icons/audio-lines.svg",
        "bubble-chat-question": "./assets/icons/bubble-chat-question.svg",
        "calendar-sync": "./assets/icons/calendar-sync.svg",
        "chat-feedback": "./assets/icons/chat-feedback.svg",
        "circle-dashed": "./assets/icons/circle-dashed.svg",
        "container": "./assets/icons/container.svg",
        "file-x2": "./assets/icons/file-x2.svg",
        "rows3": "./assets/icons/rows3.svg",
        "idea": "./assets/icons/idea.svg",
        "lightbulb-off": "./assets/icons/lightbulb-off.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "hono": "^4.11.9",
    "jsdom": "^26.1.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
